# ==========================================
# LOCKLENS - Git Ignore Configuration
# ==========================================

# 1. Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example

# 2. Node.js dependencies
node_modules/
**/node_modules/

# 3. Frontend build artifacts
dist/
build/
coverage/
.next/
out/
.vite/
*.tsbuildinfo

# 4. Python virtual environments
.venv/
venv/
env/
ENV/

# 5. Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 6. Local databases and database files
*.db
*.sqlite
*.sqlite3
*.db-journal

# Keep intentional database initialization/migration scripts tracked.
# Do not ignore *.sql globally.

# 7. Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# 8. IDE and editor files
.vscode/
.idea/
*.code-workspace

# 9. Operating system files
.DS_Store
Thumbs.db
desktop.ini

# 10. Test and tooling artifacts
playwright-report/
test-results/
.nyc_output/

# 11. Local deployment and secret files
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# 12. Preserve example configuration templates
!.env.example
!.env.*.example